---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { translationsFor } from '../../i18n/translations.js';
import './changelog.css';

const { locale } = Astro.props;
const translations = translationsFor(locale);
---
<SiteLayout page="changelog" locale={locale} translations={translations}>
<main id="main">
  <section class="page" aria-labelledby="page-title">
    <div class="shell">
      <p class="eyebrow">CleanU</p>
      <h1 id="page-title" class="page__title">{translations.common.changelog}</h1>
      <p class="lede">{translations.changelog.intro}</p>
      <p class="page__status" data-log-status role="status">{translations.changelog.loading}</p>
      <ol class="log" data-log></ol>
      <p class="page__foot"><a href="https://github.com/youngluo/cleanu/releases">{translations.changelog.github}</a></p>
    </div>
  </section>
</main>
<script src="./changelog.js"></script>
</SiteLayout>
