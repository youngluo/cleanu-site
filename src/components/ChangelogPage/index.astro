---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { copyFor } from '../../i18n/copy.js';
import '../../styles/changelog.css';

const { locale } = Astro.props;
const copy = copyFor(locale);
---
<SiteLayout page="changelog" locale={locale} copy={copy}>
<main id="main">
  <section class="page" aria-labelledby="page-title">
    <div class="shell">
      <p class="eyebrow">CleanU</p>
      <h1 id="page-title" class="page__title">{copy.common.changelog}</h1>
      <p class="lede">{copy.changelog.intro}</p>
      <p class="page__status" data-log-status role="status">{copy.changelog.loading}</p>
      <ol class="log" data-log></ol>
      <p class="page__foot"><a href="https://github.com/youngluo/cleanu/releases">{copy.changelog.github}</a></p>
    </div>
  </section>
</main>
<script src="../../scripts/changelog.js"></script>
</SiteLayout>
