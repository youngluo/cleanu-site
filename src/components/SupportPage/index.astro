---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { translationsFor } from '../../i18n/translations.js';

const { locale } = Astro.props;
const translations = translationsFor(locale);
---
<SiteLayout page="support" locale={locale} translations={translations}>
<main id="main">
  <section class="page" aria-labelledby="page-title">
    <div class="shell">
      <h1 id="page-title" class="page__title">{translations.common.helpFeedback}</h1>
      <p class="lede">{translations.support.intro}</p>
      <div class="reading">
        <section class="reading__section">
          <h2>{translations.support.purchaseTitle}</h2>
          <p>
            {translations.support.purchaseBodyBeforePortal}
            <a href="https://customer.dodopayments.com/" rel="noopener noreferrer">{translations.support.portalName}</a>
            {translations.support.purchaseBodyAfterPortal}{locale === 'en' ? ' ' : ''}
            {translations.support.purchaseSteps}
          </p>
        </section>
        <section class="reading__section">
          <h2>{translations.support.issueTitle}</h2>
          <p>
            {translations.support.issueBodyBeforeLink}
            <a href="https://github.com/youngluo/cleanu-site/issues">{translations.support.issueLink}</a>
            {translations.support.issueBodyAfterLink}
          </p>
        </section>
        <section class="reading__section">
          <h2>{translations.support.privacyTitle}</h2>
          <p>{translations.support.privacyBody}</p>
        </section>
        <section class="reading__section">
          <h2>{translations.support.officialEmailTitle}</h2>
          <p>
            {translations.support.officialEmailBody}{' '}
            <a href={`mailto:${translations.support.officialEmail}`}>{translations.support.officialEmail}</a>
            {locale === 'en' ? '.' : '。'}
          </p>
        </section>
      </div>
    </div>
  </section>
</main></SiteLayout>
