---
import { assetHref, pageHref } from '../../i18n/translations.js';

const { page, locale, translations } = Astro.props;
---

<footer class="foot">
  <div class="shell foot__inner">
    <div class="foot__brand">
      <span class="brand brand--foot">
        <img class="brand__mark" src={assetHref('assets/icon.webp')} width="512" height="512" alt="">
        <span>CleanU</span>
      </span>
      <p>{translations.tagline}</p>
    </div>
    <nav class="foot__links" aria-label={translations.support}>
      <h3>{translations.support}</h3>
      <ul>
        <li><a href="https://github.com/youngluo/cleanu-site">GitHub</a></li>
        <li><a href={pageHref('changelog', locale)} aria-current={page === 'changelog' ? 'page' : undefined}>{translations.changelog}</a></li>
        <li><a href={pageHref('support', locale)} aria-current={page === 'support' ? 'page' : undefined}>{translations.helpFeedback}</a></li>
      </ul>
    </nav>
    <nav class="foot__links" aria-label={translations.legal}>
      <h3>{translations.legal}</h3>
      <ul>
        <li><a href={pageHref('privacy', locale)} aria-current={page === 'privacy' ? 'page' : undefined}>{translations.privacy}</a></li>
      </ul>
    </nav>
  </div>
</footer>
