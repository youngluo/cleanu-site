---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { pageHref, translationsFor } from '../../i18n/translations.js';
const { locale } = Astro.props;
const translations = translationsFor(locale);
const copy = translations.terms;
---
<SiteLayout page="terms" locale={locale} translations={translations}>
  <main id="main">
    <section class="page" aria-labelledby="page-title">
      <div class="shell">
        <h1 id="page-title" class="page__title">{translations.common.terms}</h1>
        <p class="lede">{copy.intro}</p>
        <div class="reading">
          {['license', 'trial', 'refund', 'devices', 'support', 'ip', 'disclaimer'].map((section) => <section class="reading__section">
            <h2>{copy[`${section}Title`]}</h2>
            {section === 'support' ? (
              <p>{copy.supportBodyBefore}<a href={pageHref('support', locale)}>{copy.supportLink}</a>{copy.supportBodyAfter}</p>
            ) : (
              <p>{copy[`${section}Body`]}</p>
            )}
          </section>)}
        </div>
      </div>
    </section>
  </main>
</SiteLayout>
