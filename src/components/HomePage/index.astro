---
import { loadReleases, downloadPath } from '../../data/releases.js';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { assetHref, pageHref, translationsFor } from '../../i18n/translations.js';
import { checkedPurchaseConfig, checkoutHref } from '../../data/purchase.js';
import './home.css';

const { locale } = Astro.props;
const translations = translationsFor(locale);
const latestRelease = (await loadReleases())[0];
const downloadHref = latestRelease ? assetHref(downloadPath(latestRelease)) : pageHref('changelog', locale);
const purchase = await checkedPurchaseConfig();
const purchaseHref = purchase.enabled ? checkoutHref(purchase, process.env.SITE_URL, locale) : null;
---
<SiteLayout page="index" locale={locale} translations={translations}>
<main id="main">

  <!-- 首屏 -->
  <section class="hero" id="download" aria-labelledby="hero-title">
    <div class="shell hero__grid">
      <div class="hero__copy">
        <div class="hero__brand">
          <h1 id="hero-title" class="hero__brand-name">CleanU</h1>
          <p class="eyebrow">{translations.index.eyebrow}</p>
        </div>
        <p class="hero__desc">{translations.index.intro}</p>
        <div class="hero__actions">
          <a class="btn btn--primary" href={downloadHref} data-download>{translations.index.download}</a>
        </div>
        <p class="hero__meta"><span>macOS 13+</span><span aria-hidden="true">·</span><span>{translations.index.lifetimeUpdates}</span></p>
      </div>

    </div>
  </section>


  <section id="screens" class="section" aria-label={translations.index.previewRegion}>
    <div class="shell">
      <div class="screens__grid">
        <div class="show" data-show>
          <div class="show__bar">
            <p class="show__label" id="screens-label">{translations.index.previewLabel}</p>
            <div role="tablist" aria-labelledby="screens-label" class="tabs" data-tabs>
              <span class="tabs__thumb" aria-hidden="true"></span>
              <button type="button" role="tab" id="tab-idle" aria-controls="state-idle" aria-selected="true" tabindex="0">{translations.index.tabIdle}</button>
              <button type="button" role="tab" id="tab-scanning" aria-controls="state-scanning" aria-selected="false" tabindex="-1">{translations.index.tabScanning}</button>
              <button type="button" role="tab" id="tab-review" aria-controls="state-review" aria-selected="false" tabindex="-1">{translations.index.tabReview}</button>
              <button type="button" role="tab" id="tab-selected" aria-controls="state-selected" aria-selected="false" tabindex="-1">{translations.index.tabSelected}</button>
              <button type="button" role="tab" id="tab-done" aria-controls="state-done" aria-selected="false" tabindex="-1">{translations.index.tabDone}</button>
            </div>
          </div>

          <div class="show__stage">
            <figure class="shot-frame" id="state-idle" role="tabpanel" aria-labelledby="tab-idle" tabindex="0">
              <img class="shot" src={assetHref('assets/shot-idle.webp')} width="2048" height="2116" loading="lazy" alt={translations.index.altIdle}>
            </figure>
            <figure class="shot-frame" id="state-scanning" role="tabpanel" aria-labelledby="tab-scanning" tabindex="0">
              <img class="shot" src={assetHref('assets/shot-scanning.webp')} width="2048" height="2116" loading="lazy" alt={translations.index.altScanning}>
            </figure>
            <figure class="shot-frame" id="state-review" role="tabpanel" aria-labelledby="tab-review" tabindex="0" data-pan="bottom">
              <img class="shot" src={assetHref('assets/shot-review.webp')} width="2048" height="2116" loading="lazy" alt={translations.index.altReview}>
            </figure>
            <figure class="shot-frame" id="state-selected" role="tabpanel" aria-labelledby="tab-selected" tabindex="0" data-pan="bottom">
              <img class="shot" src={assetHref('assets/shot-selected.webp')} width="2048" height="2116" loading="lazy" alt={translations.index.altSelected}>
            </figure>
            <figure class="shot-frame" id="state-done" role="tabpanel" aria-labelledby="tab-done" tabindex="0" data-pan="bottom">
              <img class="shot" src={assetHref('assets/shot-done.webp')} width="2048" height="2116" loading="lazy" alt={translations.index.altDone}>
            </figure>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- 功能与安全边界 -->
  <section id="features" class="section" aria-labelledby="features-title">
    <div class="shell">
      <div class="section__head" data-reveal>
        <h2 id="features-title">{translations.common.features}</h2>
        <p>{translations.index.featureIntro}</p>
      </div>
      <div class="cards">
        <article class="card" data-reveal>
          <h3>{translations.index.featureScan}</h3>
          <p>{translations.index.featureScanBody}</p>
        </article>
        <article class="card" data-reveal>
          <h3>{translations.index.featureReview}</h3>
          <p>{translations.index.featureReviewBody}</p>
        </article>
      </div>
      <div id="how" class="safety-summary" aria-labelledby="how-title">
        <div class="safety-summary__head" data-reveal>
          <h3 id="how-title">{translations.common.safety}</h3>
        </div>
        <ul class="rules" data-reveal>
          <li class="rule">
            <h4>{translations.index.safetyRead}</h4>
            <p>{translations.index.safetyReadBody}</p>
          </li>
          <li class="rule">
            <h4>{translations.index.safetyConfirm}</h4>
            <p>{translations.index.safetyConfirmBody}</p>
          </li>
          <li class="rule">
            <h4>{translations.index.safetyCheck}</h4>
            <p>{translations.index.safetyCheckBody}</p>
          </li>
          <li class="rule">
            <h4>{translations.index.safetyTrash}</h4>
            <p>{translations.index.safetyTrashBody}</p>
          </li>
          <li class="rule">
            <h4>{translations.index.safetyPermissions}</h4>
            <p>{translations.index.safetyPermissionsBody}</p>
          </li>
        </ul>
      </div>
    </div>
  </section>


  <section id="pricing" class="section" aria-labelledby="pricing-title">
    <div class="shell">
      <div class="section__head">
        <h2 id="pricing-title">{translations.common.pricing}</h2>
        <p>{translations.index.pricingIntro}</p>
      </div>
      <div class="pricing">
        <div class="pricing__purchase">
          <p class="pricing__amount">
            <span class="pricing__value">{translations.index.pricingPrice}</span>
          </p>
          <p class="pricing__note">{translations.index.pricingPayment}</p>
          <div class="pricing__actions">
            {purchaseHref
              ? <a class="btn btn--primary" href={purchaseHref} rel="noreferrer">{translations.index.pricingBuy}</a>
              : <button class="btn btn--primary" type="button" disabled>{translations.index.pricingClosed}</button>}
          </div>
          <p class="pricing__note"><a href={pageHref('terms', locale)}>{translations.common.terms}</a></p>
          <p class="pricing__note">{translations.index.pricingTax}</p>
        </div>
        <ul class="pricing__terms">
          <li>
            <h3>{translations.index.pricingTrial}</h3>
            <p>{translations.index.pricingTrialBody}</p>
          </li>
          <li>
            <h3>{translations.index.pricingUpdates}</h3>
            <p>{translations.index.pricingUpdatesBody}</p>
          </li>
          <li>
            <h3>{translations.index.pricingDevices}</h3>
            <p>{translations.index.pricingDevicesBody}</p>
          </li>
        </ul>
      </div>
    </div>
  </section>


  <section id="faq" class="section" aria-labelledby="faq-title">
    <div class="shell">
      <div class="section__head" data-reveal>
        <h2 id="faq-title">{translations.common.faq}</h2>
      </div>
      <div class="faq" data-faq>
        <div class="faq__item">
          <h3><button type="button" class="faq__q" aria-expanded="true" aria-controls="a1" id="q1">{translations.index.faqStorage}</button></h3>
          <div class="faq__a" id="a1" role="region" aria-labelledby="q1">
            <div class="faq__a-inner">
              <p>{translations.index.faqStorageBody}</p>
            </div>
          </div>
        </div>
        <div class="faq__item">
          <h3><button type="button" class="faq__q" aria-expanded="true" aria-controls="a3" id="q3">{translations.index.faqAccess}</button></h3>
          <div class="faq__a" id="a3" role="region" aria-labelledby="q3">
            <div class="faq__a-inner">
              <p>{translations.index.faqAccessBody}</p>
            </div>
          </div>
        </div>
        <div class="faq__item">
          <h3><button type="button" class="faq__q" aria-expanded="true" aria-controls="a2" id="q2">{translations.index.faqDeletion}</button></h3>
          <div class="faq__a" id="a2" role="region" aria-labelledby="q2">
            <div class="faq__a-inner">
              <p>{translations.index.faqDeletionBefore}<code>node_modules</code>{translations.index.faqDeletionAfter}</p>
            </div>
          </div>
        </div>
        <div class="faq__item">
          <h3><button type="button" class="faq__q" aria-expanded="true" aria-controls="a4" id="q4">{translations.index.faqUpload}</button></h3>
          <div class="faq__a" id="a4" role="region" aria-labelledby="q4">
            <div class="faq__a-inner">
              <p>{translations.index.faqUploadBody}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>
<script src="./home.js"></script>
</SiteLayout>
