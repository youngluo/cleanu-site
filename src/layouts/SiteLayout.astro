---
import '../styles/site.css';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import SiteHeader from '../components/SiteHeader/index.astro';
import SiteFooter from '../components/SiteFooter/index.astro';
import { assetHref, pageRoute, runtimeTranslationsFor } from '../i18n/translations.js';

const { page, locale, translations } = Astro.props;
const pageTranslations = translations[page];
const alternateLocales = ['zh-CN', 'en'];
const alternates = Astro.site
  ? alternateLocales.map((alternateLocale) => ({
      locale: alternateLocale,
      href: getAbsoluteLocaleUrl(alternateLocale, pageRoute(page)),
    }))
  : [];
const runtimeTranslations = runtimeTranslationsFor(translations);
---

<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {page === 'checkout' && <>
      <meta name="robots" content="noindex, noarchive">
      <meta name="referrer" content="no-referrer">
      <script is:inline>
        (function () {
          try {
            var status = new URLSearchParams(location.search).get('status');
            document.documentElement.dataset.checkoutStatus = ['succeeded', 'processing', 'failed', 'cancelled'].includes(status) ? status : 'unknown';
          } catch (e) { /* keep neutral guidance */ }
          try { history.replaceState(null, '', location.pathname); } catch (e) { /* no-referrer still applies */ }
        })();
      </script>
    </>}
    <title>{pageTranslations.title}</title>
    <meta name="description" content={pageTranslations.description}>
    <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#121514" media="(prefers-color-scheme: dark)">
    {alternates.map(({ locale: alternateLocale, href }) => <link rel="alternate" hreflang={alternateLocale} href={href} />)}
    <link rel="icon" href={assetHref('favicon.svg')} type="image/svg+xml">
    <script is:inline>
      document.documentElement.classList.add('has-js');
      try {
        var mode = localStorage.getItem('cleanu:theme-mode');
        if (mode === 'light' || mode === 'dark' || mode === 'auto') document.documentElement.dataset.themeMode = mode;
      } catch (e) { /* use system preference */ }
    </script>
  </head>
  <body id="top">
    <SiteHeader page={page} locale={locale} translations={translations.common} />
    <slot />
    <SiteFooter page={page} locale={locale} translations={translations.common} />
    <script type="application/json" id="site-translations" set:html={runtimeTranslations}></script>
    <script src="../common/site.js"></script>
  </body>
</html>
